{
  "expo": {
    "name": "liveRadar",
    "slug": "liveRadar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LiveRadar to use your location so we can show nearby events, experiences, and activities."
        }
      ]
    ]
  }
}
